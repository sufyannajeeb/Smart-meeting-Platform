SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
# Leave WHISPER_LANGUAGE empty for auto-detection, or set e.g. en/hi/ta
WHISPER_LANGUAGE=
MAX_UPLOAD_MB=500

# ---- WebRTC STUN/TURN (required for connections across different networks) ----
# STUN-only (default) connects peers only when they share a LAN. For users on
# separate networks you MUST configure a TURN relay, e.g. coturn / Twilio /
# Cloudflare. Example:
#   TURN_URLS=turn:turn.example.com:3478,turn:turn.example.com:3478?transport=tcp
#   TURN_USERNAME=myuser
#   TURN_CREDENTIAL=mypassword
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Cloudflare Realtime TURN — free up to 1,000 GB/month, no credit card.
# Create a TURN app at Cloudflare Dashboard -> Realtime -> TURN, then paste:
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=